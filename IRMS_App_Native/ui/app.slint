// IRMS native prototype shell: top navigation, the five screens, calibration wizard.
// Simulated data only; not connected to the shipping app. No page-level scrolling anywhere.
import { Theme, Btn, Card, Chip, App } from "theme.slint";
import { Live, LiveView } from "live.slint";
import { ActionsView, HistoryView, ToolsView, SettingsView } from "pages.slint";
export { Theme, App, Live }

component NavTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    width: t.preferred-width + 28px;
    Text { x: 14px; text: root.text; font-size: 15px; font-weight: root.active ? 700 : 500; color: root.active ? Theme.accent : Theme.ink; vertical-alignment: center; }
    t := Text { text: root.text; font-size: 15px; font-weight: 700; visible: false; }
    Rectangle { x: 14px; y: parent.height - 4px; width: parent.width - 28px; height: 4px; border-radius: 2px; background: root.active ? Theme.accent : transparent; }
    TouchArea { clicked => { root.clicked(); } }
}

component Wizard inherits Rectangle {
    property <int> step: 0;
    property <float> progress: 0;
    property <[string]> titles: ["步驟 1 / 3 · 捕捉零位", "步驟 2 / 3 · 抬大腿", "步驟 3 / 3 · 勾小腿"];
    property <[string]> bodies: [
        "自然站直,保持不動,讓系統記下這個姿勢作為零位。",
        "大腿向前抬高至少 20°(建議 40–60°),再慢慢放下。",
        "大腿保持不動,小腿向後勾起,再慢慢放下。",
    ];
    background: #000000.with-alpha(0.45);
    TouchArea { }
    Timer {
        interval: 50ms;
        running: root.progress > 0 && root.progress < 1;
        triggered => { root.progress = min(1, root.progress + 0.035); }
    }
    Card {
        width: 520px; height: 300px;
        VerticalLayout {
            padding: 26px; spacing: 14px;
            Text { text: "校準精靈"; font-size: 13px; color: Theme.dim; }
            Text { text: root.titles[root.step]; font-size: 22px; font-weight: 700; color: Theme.ink; }
            Text { text: root.bodies[root.step]; font-size: 15px; color: Theme.dim; wrap: word-wrap; }
            Rectangle {
                height: 10px; border-radius: 5px; background: Theme.raised;
                Rectangle { x: 0; width: parent.width * root.progress; height: parent.height; border-radius: 5px; background: Theme.good; }
            }
            Text { text: root.progress >= 1 ? "已完成這個步驟" : root.progress > 0 ? "擷取中…請保持動作" : "準備好後按「開始擷取」"; font-size: 13px; color: root.progress >= 1 ? Theme.good : Theme.dim; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                Btn { text: "取消"; clicked => { root.step = 0; root.progress = 0; App.wizard-open = false; } }
                Rectangle { horizontal-stretch: 1; }
                if root.progress < 1: Btn { text: "開始擷取"; primary: true; enabled: root.progress == 0; clicked => { root.progress = 0.01; } }
                if root.progress >= 1: Btn {
                    text: root.step == 2 ? "完成校準" : "下一步"; primary: true;
                    clicked => {
                        if (root.step == 2) { App.calibrated = true; App.wizard-open = false; root.step = 0; } else { root.step += 1; }
                        root.progress = 0;
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "IRMS Native prototype";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 680px;
    default-font-family: "Microsoft JhengHei";
    background: Theme.canvas;

    VerticalLayout {
        // top navigation
        Rectangle {
            height: 60px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 24px; padding-right: 20px; spacing: 6px;
                Text { text: "IRMS"; font-size: 21px; font-weight: 800; color: Theme.accent; vertical-alignment: center; }
                Rectangle { width: 14px; }
                for t[i] in ["即時監測", "動作處方", "療程紀錄", "工具", "設定"]: NavTab { text: t; active: App.view == i; clicked => { App.view = i; } }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: App.conn == 2 ? Theme.good : App.conn == 1 ? Theme.warn : Theme.border; } }
                    Text { text: App.conn == 2 ? "裝置已連線" : App.conn == 1 ? "連線中…" : "未連線"; font-size: 13px; color: Theme.dim; vertical-alignment: center; }
                }
                Rectangle { width: 6px; }
                VerticalLayout {
                    alignment: center;
                    Btn { text: App.conn == 2 ? "中斷連線" : App.conn == 1 ? "連線中…" : "連線裝置"; primary: App.conn == 0; enabled: App.conn != 1; clicked => { App.request-connect(); } }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }

        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 22px; padding-bottom: 10px;
                if App.view == 0: LiveView { }
                if App.view == 1: ActionsView { }
                if App.view == 2: HistoryView { }
                if App.view == 3: ToolsView { }
                if App.view == 4: SettingsView { }
            }
        }

        HorizontalLayout {
            height: 30px; padding-left: 24px; padding-right: 24px;
            Text { text: "IRMS 智慧復健監測 · 原生介面原型"; font-size: 12px; color: Theme.dim; vertical-alignment: center; }
            Text { text: "模擬資料 · 不是真實量測"; font-size: 12px; color: Theme.warn; horizontal-alignment: right; vertical-alignment: center; }
        }
    }

    if App.wizard-open: Wizard { width: 100%; height: 100%; }
}
