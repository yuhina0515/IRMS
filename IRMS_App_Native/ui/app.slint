// IRMS native prototype shell: top navigation, the five screens, calibration wizard.
// Simulated data only; not connected to the shipping app. No page-level scrolling anywhere.
import { Theme, Btn, Card, Chip, App } from "theme.slint";
import { Live, LiveView } from "live.slint";
import { ActionsView, HistoryView, ToolsView, SettingsView } from "pages.slint";
import { AboutSlint } from "std-widgets.slint";
import { ActionEditor, MutationConfirmation } from "editors.slint";
export { Theme, App, Live }

component NavTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    width: t.preferred-width + 28px;
    Text { x: 14px; text: root.text; font-size: 15px; font-weight: root.active ? 700 : 500; color: root.active ? Theme.accent : Theme.ink; vertical-alignment: center; }
    t := Text { text: root.text; font-size: 15px; font-weight: 700; visible: false; }
    Rectangle { x: 14px; y: parent.height - 4px; width: parent.width - 28px; height: 4px; border-radius: 2px; background: root.active ? Theme.accent : transparent; }
    TouchArea { clicked => { root.clicked(); } }
}

component Wizard inherits Rectangle {
    background: #000000.with-alpha(0.45);
    TouchArea { }
    Card {
        width: 620px; height: 480px;
        VerticalLayout {
            padding: 26px; spacing: 12px;
            HorizontalLayout {
                Text { text: "校準精靈"; font-size: 13px; color: Theme.dim; horizontal-stretch: 1; }
                Text { text: App.wizard-label; font-size: 13px; color: Theme.dim; }
            }
            Text { text: App.wizard-title; font-size: 22px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
            if App.wizard-body != "": Text { text: App.wizard-body; font-size: 15px; color: Theme.dim; wrap: word-wrap; }

            // Prepare: leg, preset, reference kind and posture.
            if App.wizard-page == 0: VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "穿戴的腿"; font-size: 14px; color: Theme.dim; vertical-alignment: center; width: 90px; }
                    Btn { text: "左腿"; active: App.wizard-side == 0; enabled: App.wizard-preset != 2; clicked => { App.wizard-set-side(0); } }
                    Btn { text: "右腿"; active: App.wizard-side == 1; enabled: App.wizard-preset != 2; clicked => { App.wizard-set-side(1); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "內容"; font-size: 14px; color: Theme.dim; vertical-alignment: center; width: 90px; }
                    Btn { text: "校準"; active: App.wizard-preset == 0; clicked => { App.wizard-set-preset(0); } }
                    Btn { text: "活動度量測"; active: App.wizard-preset == 1; clicked => { App.wizard-set-preset(1); } }
                    Btn { text: "快速歸零"; active: App.wizard-preset == 2; clicked => { App.wizard-set-preset(2); } }
                }
                if App.wizard-preset != 2: HorizontalLayout {
                    spacing: 8px;
                    Text { text: "起始姿勢"; font-size: 14px; color: Theme.dim; vertical-alignment: center; width: 90px; }
                    Btn { text: "站立"; active: App.wizard-posture == 0; clicked => { App.wizard-set-posture(0); } }
                    Btn { text: "長坐(腿伸直)"; active: App.wizard-posture == 1; clicked => { App.wizard-set-posture(1); } }
                    Btn { text: "仰躺"; active: App.wizard-posture == 2; clicked => { App.wizard-set-posture(2); } }
                }
                if App.wizard-preset != 2: HorizontalLayout {
                    spacing: 8px;
                    Rectangle { width: 90px; }
                    Btn { text: "坐姿(膝彎90°)"; active: App.wizard-posture == 3; clicked => { App.wizard-set-posture(3); } }
                    Btn { text: "其他姿勢"; active: App.wizard-posture == 4; clicked => { App.wizard-set-posture(4); } }
                    Btn { text: "無法完全伸直"; active: App.wizard-neutral; clicked => { App.wizard-set-neutral(!App.wizard-neutral); } }
                }
                if App.wizard-preset == 1: Text { text: "髖部動作只用大腿感測器,量到的是大腿相對自然站姿的傾斜;請保持軀幹不動。外展的可信度低於前後方向。"; font-size: 12px; color: Theme.dim; wrap: word-wrap; }
                if App.wizard-preset == 2 && !App.wizard-has-stored: Text { text: "沒有可沿用的校準,請先完成一次完整校準。"; font-size: 13px; color: Theme.danger; wrap: word-wrap; }
            }

            // Capture pages.
            if App.wizard-page == 1 || App.wizard-page == 2: VerticalLayout {
                spacing: 12px;
                Rectangle {
                    height: 10px; border-radius: 5px; background: Theme.raised;
                    Rectangle { x: 0; width: parent.width * App.wizard-progress; height: parent.height; border-radius: 5px; background: App.wizard-tone == 2 ? Theme.danger : Theme.good; }
                }
                Text {
                    text: App.wizard-status;
                    font-size: 13px; wrap: word-wrap;
                    color: App.wizard-tone == 1 ? Theme.good : App.wizard-tone == 2 ? Theme.danger : Theme.dim;
                }
            }

            // Review: what was solved, per movement, and the optional range-of-motion record.
            if App.wizard-page == 3: VerticalLayout {
                spacing: 10px;
                Text { text: App.wizard-result; font-size: 14px; color: App.wizard-tone == 2 ? Theme.danger : Theme.ink; wrap: word-wrap; }
                if App.wizard-can-save-mobility: Btn { text: App.wizard-save-mobility ? "✓ 記錄這次活動度" : "不記錄這次活動度"; active: App.wizard-save-mobility; clicked => { App.wizard-toggle-save(); } }
                if App.wizard-status != "": Text { text: App.wizard-status; font-size: 13px; color: Theme.danger; wrap: word-wrap; }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                Btn { text: "取消"; enabled: !App.wizard-busy; clicked => { App.wizard-cancel(); } }
                if App.wizard-page == 2 && App.wizard-can-skip: Btn { text: "略過"; clicked => { App.wizard-skip(); } }
                if App.wizard-page == 3 || (App.wizard-page == 2 && App.wizard-preset != 2): Btn { text: "重新捕捉零位"; enabled: !App.wizard-busy; clicked => { App.wizard-recapture(); } }
                if App.wizard-page == 3 && App.wizard-can-redo: Btn { text: "重做動作"; clicked => { App.wizard-redo(); } }
                Rectangle { horizontal-stretch: 1; }
                if App.wizard-page == 0: Btn { text: "開始"; primary: true; enabled: App.wizard-can-begin; clicked => { App.wizard-begin(); } }
                if (App.wizard-page == 1 || App.wizard-page == 2) && !App.wizard-step-done: Btn {
                    text: App.wizard-busy ? "擷取中…" : "開始擷取 (" + round(App.wizard-seconds) + " 秒)";
                    primary: true; enabled: !App.wizard-busy;
                    clicked => { App.wizard-start(); }
                }
                if (App.wizard-page == 1 || App.wizard-page == 2) && App.wizard-step-done: Btn { text: "下一步"; primary: true; clicked => { App.wizard-next(); } }
                if App.wizard-page == 3: Btn { text: "套用校準"; primary: true; enabled: App.wizard-can-apply; clicked => { App.wizard-apply(); } }
            }
        }
    }
}

component WearingCheck inherits Rectangle {
    background: #000000.with-alpha(0.45);
    TouchArea { }
    Card {
        width: 560px; height: 330px;
        VerticalLayout {
            padding: 26px; spacing: 12px;
            Text { text: "療程前"; font-size: 13px; color: Theme.dim; }
            Text { text: "穿戴檢查"; font-size: 22px; font-weight: 700; color: Theme.ink; }
            Text { text: App.wearing-body; font-size: 15px; color: App.wearing-verdict >= 4 ? Theme.danger : App.wearing-verdict == 1 ? Theme.good : Theme.dim; wrap: word-wrap; }
            if App.wearing-page == 1: Rectangle {
                height: 10px; border-radius: 5px; background: Theme.raised;
                Rectangle { x: 0; width: parent.width * App.wearing-progress; height: parent.height; border-radius: 5px; background: Theme.good; }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 10px;
                Btn { text: "取消"; clicked => { App.wearing-cancel(); } }
                if App.wearing-page == 2 && App.wearing-verdict >= 4: Btn { text: "重新校準"; clicked => { App.wearing-recalibrate(); } }
                if App.wearing-page == 2 && App.wearing-verdict >= 2: Btn { text: "再檢查一次"; clicked => { App.wearing-retry(); } }
                Rectangle { horizontal-stretch: 1; }
                if App.wearing-page == 0: Btn { text: "開始檢查"; primary: true; clicked => { App.wearing-begin(); } }
                if App.wearing-page == 2 && App.wearing-verdict == 3: Btn { text: "歸零並開始"; primary: true; clicked => { App.wearing-rezero(); } }
                if App.wearing-page == 2 && App.wearing-verdict >= 2 && App.wearing-verdict != 3: Btn { text: "仍要開始"; clicked => { App.wearing-start-anyway(); } }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <string> release-version;
    private property <bool> about-open: false;
    title: "IRMS v" + root.release-version + " · Native Beta";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 680px;
    default-font-family: "Microsoft JhengHei";
    background: Theme.canvas;

    VerticalLayout {
        // top navigation
        Rectangle {
            height: 60px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 24px; padding-right: 20px; spacing: 6px;
                Text { text: "IRMS"; font-size: 21px; font-weight: 800; color: Theme.accent; vertical-alignment: center; }
                Rectangle { width: 14px; }
                for t[i] in ["即時監測", "動作處方", "療程紀錄", "工具", "設定"]: NavTab { text: t; active: App.view == i; clicked => { App.view = i; } }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: App.conn == 2 ? Theme.good : App.conn == 1 ? Theme.warn : Theme.border; } }
                    Text { text: App.conn == 2 ? "裝置已連線" : App.conn == 1 ? "連線中…" : "未連線"; font-size: 13px; color: Theme.dim; vertical-alignment: center; }
                }
                Rectangle { width: 6px; }
                VerticalLayout {
                    alignment: center;
                    Btn { text: App.closing || App.disconnecting ? "正在收尾…" : App.conn == 2 ? "中斷連線" : App.conn == 1 ? "連線中…" : "連線裝置"; primary: App.conn == 0; enabled: App.conn != 1 && !App.closing && !App.disconnecting; clicked => { App.request-connect(); } }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }

        if App.storage-error != "": Text { text: App.storage-error; color: Theme.danger; wrap: word-wrap; }
        if App.feedback-error != "": Text { text: App.feedback-error; color: Theme.danger; wrap: word-wrap; }
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 22px; padding-bottom: 10px;
                if App.view == 0: LiveView { }
                if App.view == 1: ActionsView { }
                if App.view == 2: HistoryView { }
                if App.view == 3: ToolsView { }
                if App.view == 4: SettingsView { }
            }
        }

        HorizontalLayout {
            height: 30px; padding-left: 24px; padding-right: 24px;
            Text { text: "IRMS v" + root.release-version + " · 原生測試版"; font-size: 12px; color: Theme.dim; vertical-alignment: center; }
            Btn { text: "關於"; min-height: 26px; clicked => { root.about-open = true; } }
            Text { text: App.device-mode ? "裝置資料" : "模擬資料 · 不是真實量測"; font-size: 12px; color: Theme.warn; horizontal-alignment: right; vertical-alignment: center; }
        }
    }

    if App.wizard-open: Wizard { width: 100%; height: 100%; }
    if App.wearing-open: WearingCheck { width: 100%; height: 100%; }
    if App.editor-open: ActionEditor { width: 100%; height: 100%; }
    if App.confirmation-open: MutationConfirmation { width: 100%; height: 100%; }
    // 隨應用程式顯示 Slint 官方歸屬元件，符合桌面免權利金授權條件。
    if root.about-open: Rectangle {
        width: 100%; height: 100%; background: #000000.with-alpha(0.45);
        TouchArea { }
        Card {
            width: 480px; height: 300px;
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Text { text: "IRMS v" + root.release-version; font-size: 22px; color: Theme.ink; }
                Text { text: "Windows 原生測試版 · 真機驗收尚未完成"; color: Theme.dim; }
                AboutSlint { }
                Btn { text: "關閉"; clicked => { root.about-open = false; } }
            }
        }
    }
}
