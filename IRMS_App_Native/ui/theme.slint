// Shared palette and small widgets. Palette index = style * 2 + (night ? 1 : 0).
// Styles: 0 Workbook (v3 carry-over), 1 Calm companion (chosen 2026-11-16), 2 Dark studio.
export global Theme {
    in-out property <int> style: 1;
    in-out property <bool> night: false;
    out property <int> idx: root.style * 2 + (root.night ? 1 : 0);
    out property <color> canvas: [#EEEAE2, #161E20, #E9F0EA, #1B2420, #1A1C21, #101114][root.idx];
    out property <color> surface: [#FFFCF6, #1D282A, #F8FBF7, #232F29, #22252B, #181A1F][root.idx];
    out property <color> raised: [#E8E2D8, #283638, #DCE8DF, #2F3E36, #2C3037, #23262D][root.idx];
    out property <color> border: [#CFC6BD, #45585A, #BFD0C4, #46594D, #3A3F47, #353941][root.idx];
    out property <color> ink: [#29252D, #E7EFEC, #25332B, #E6F0E9, #ECEDEF, #ECEDEF][root.idx];
    out property <color> dim: [#625C65, #AEC1BF, #5E6F64, #A9BBB0, #A0A4AC, #A0A4AC][root.idx];
    out property <color> accent: [#684563, #97CCDE, #3F8F6B, #7FD1A8, #FF8A3D, #FF8A3D][root.idx];
    out property <color> on-accent: [#FFFFFF, #161E20, #FFFFFF, #10201A, #101114, #101114][root.idx];
    out property <color> good: [#2E7D4F, #6FD39A, #2E7D4F, #7FD1A8, #5BD48A, #5BD48A][root.idx];
    out property <color> warn: [#9A6412, #F0BE6A, #9A6412, #F0BE6A, #F0BE6A, #F0BE6A][root.idx];
    out property <color> danger: [#B3362F, #FF8F85, #B3362F, #FF8F85, #FF6B5E, #FF6B5E][root.idx];
    out property <length> radius: [6px, 6px, 18px, 18px, 4px, 4px][root.idx];
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <bool> quiet: false;
    in property <color> ink: Theme.ink;
    callback clicked;
    min-height: 40px;
    min-width: label.preferred-width + 32px;
    border-radius: min(Theme.radius, self.height / 2);
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary || root.active ? Theme.accent : root.quiet ? transparent : ta.has-hover && root.enabled ? Theme.border : Theme.raised;
    border-width: root.quiet ? 0 : 1px;
    border-color: root.primary || root.active ? Theme.accent : Theme.border;
    label := Text {
        text: root.text;
        color: root.primary || root.active ? Theme.on-accent : root.ink;
        font-size: 15px;
        font-weight: root.primary ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    callback edited(string);
    height: 40px;
    border-radius: min(Theme.radius, 20px);
    background: Theme.canvas;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    if input.text == "": Text { x: 14px; text: root.placeholder; font-size: 15px; color: Theme.dim; vertical-alignment: center; }
    input := TextInput {
        x: 14px; width: parent.width - 28px;
        font-size: 15px; color: Theme.ink;
        vertical-alignment: center; single-line: true;
        edited => { root.edited(self.text); }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.dim;
    height: 24px;
    width: t.preferred-width + 20px;
    border-radius: 12px;
    background: root.tone.with-alpha(0.14);
    t := Text { text: root.text; font-size: 12px; color: root.tone; horizontal-alignment: center; vertical-alignment: center; }
}

export component Card inherits Rectangle {
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
}

export component PageHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> sub;
    spacing: 10px;
    VerticalLayout {
        horizontal-stretch: 1;
        Text { text: root.title; font-size: 26px; font-weight: 700; color: Theme.ink; }
        Text { text: root.sub; font-size: 13px; color: Theme.dim; }
    }
    @children
}

export struct ActionItem { name: string, kind: string, target: string, hold: string, note: string, shown: bool }
export struct SessionRow { id: string, started: string, action: string, reps: int, duration: string, demo: bool, summary: string }

// Simulated app state shared by all screens (phase 2: no real device or database behind it).
export global App {
    in property <bool> closing;
    in property <bool> disconnecting;
    in property <string> feedback-error;
    in-out property <bool> voice-enabled: true;
    in property <string> voice-status: "語音啟動中";
    in property <string> device-name: "IRMS-Sim (模擬裝置)";
    in-out property <string> release-version;
    in property <string> storage-error;
    in property <bool> session-locked;
    in property <bool> save-pending;
    in property <bool> device-mode;
    in property <bool> valid-angle;
    in-out property <int> review: -1;
    in-out property <int> view: 0;            // 0 live 1 actions 2 history 3 tools 4 settings
    in-out property <int> conn: 0;            // 0 disconnected 1 connecting 2 connected
    in-out property <bool> calibrated: false;
    in-out property <bool> wizard-open: false;
    in-out property <int> action-index: 1;
    in-out property <int> settings-tab: 0;
    in-out property <int> pose-view: 0;       // 0 2D 1 3D 2 values
    in-out property <int> comfort: -1;        // personal comfort angle, -1 = not measured
    in-out property <int> limit: -1;
    in property <[ActionItem]> actions;      // filled from Rust; `shown` follows the search box
    in-out property <string> search;
    in-out property <int> history-page: 0;
    callback search-edited(string);
    in property <[SessionRow]> sessions;
    // live values pushed from Rust
    in property <float> angle: 0;
    in property <string> angle-text: "—";
    in property <string> thigh-text: "—";
    in property <string> shin-text: "—";
    in property <string> roll-text: "—";
    callback request-connect();
    // calibration wizard, driven from Rust (irms_core::calibration on the captured vectors)
    in property <int> wizard-step: 0;          // 0 reference 1 thigh sweep 2 shin sweep 3 result
    in property <float> wizard-progress: 0;
    in property <bool> wizard-busy: false;
    in property <bool> wizard-step-done: false;
    in property <string> wizard-status;
    in property <int> wizard-tone: 0;          // 0 plain 1 good 2 problem
    in property <string> wizard-result;
    in property <float> wizard-seconds: 2;
    callback wizard-start();
    callback wizard-next();
    callback wizard-cancel();
    callback delete-session(int);
    // review statistics of the session picked in History, computed from its stored readings
    in property <string> review-summary;
    callback request-review(int);
    // the personal comfort / limit angles changed in Tools: store them
    callback range-changed(int, int);
}
