{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IRMS Dashboard",
  "version": "1.2.0-beta.8",
  "identifier": "com.irms.app.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IRMS Dashboard",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 600,
        "decorations": true,
        "backgroundColor": "#0b0f1f",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1421",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNjhBNDUzNjQ0NjA3QTkKUldTcEIwWmtVNlJvazJUTndWYytIWFNNanJHT0xWYXloRkNtSExhL2pMbnVIV0twdU9ndU1nNnQK",
      "endpoints": [
        "https://github.com/yuhina0515/IRMS/releases/latest/download/latest.json"
      ]
    }
  }
}
